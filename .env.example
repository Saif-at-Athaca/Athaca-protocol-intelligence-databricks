# Local only — copy to .env (gitignored)

# Where to store downloaded AACT files (default: ./data/aact)
AACT_DOWNLOAD_DIR=

# Optional: skip download and only refresh metadata from CTTI
AACT_METADATA_ONLY=false

# Databricks (for bundle deploy — not required for CI validate)
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=DEFAULT
